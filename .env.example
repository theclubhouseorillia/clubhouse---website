# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# --- Required -------------------------------------------------------------

# Your public website address (no trailing slash). Used for SEO and links.
NEXT_PUBLIC_SITE_URL=https://www.example.ca

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon" or "publishable" key. Safe to expose in the browser (protected by row-level security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" or "secret" key. SERVER ONLY. Never share it or prefix it with NEXT_PUBLIC_.
# Used only to store form submissions and apply spam limits.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (event and contact form notifications) -------------------------

# Resend (resend.com) API key and a sender address on a domain you've verified there.
RESEND_API_KEY=
EMAIL_FROM="Website <inquiries@example.ca>"

# Optional backup recipient if no inquiry email is set in Admin → Settings.
INQUIRY_EMAIL=

# --- Optional spam protection ----------------------------------------------

# Cloudflare Turnstile (free). Leave both blank to rely on the built-in honeypot + rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Any long random string. Used to anonymise visitor IP addresses for rate limiting.
IP_HASH_SALT=change-me-to-a-long-random-string
